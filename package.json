{
  "name": "todo-web-app",
  "version": "0.1.0",
  "private": true,
  "description": "A small todo web app: JSON API plus a vanilla JS frontend.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsc && node --watch dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome check --write .",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "1.63.0",
    "@types/node": "22.18.8",
    "lefthook": "2.1.14",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
